#!/bin/sh

ufftype="Fe6+2"

# this is needed for FE with each reactive N site (IM and PBI both at the end and in the middle; tautomers don't matter)
# and then all pairs of reactive sites.

python ../../polymof/combine_pdbs.py -o FE-3mer1-IM.pdb --min-dist 5 --bond 1:1,2:27 --bond 1:1,3:5 FE.pdb 3mer00.pdb IM.pdb 

obabel -ipdb FE-3mer1-IM.pdb -o cif -O FE-3mer1-IM.cif -xg

python ../../polymof/go_lmp_interface.py FE-3mer1-IM.cif Fe:$ufftype

python ../../polymof/extract_data.py -data data.FE-3mer1-IM -ufftype $ufftype -gafftype fe -prmtop 3mer00.prmtop -prmtop IM.prmtop > FE-3mer1-IM-extra.param

# having generated extra.param files for each complex (up to 2 bonds), find the unique entries from all files

cat *-extra.param | sort -u > extra.param
